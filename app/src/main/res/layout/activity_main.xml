<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:id="@+id/homeRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back 👋"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Here is your mood dashboard"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/dashboard_card"
            android:elevation="4dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today's Check-In"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="😊"
                android:textSize="70sp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Take a moment to reflect on how you feel today."
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:gravity="center" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvMoodQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Reminder&#10;Small steps every day can help you understand yourself better."
            android:textSize="15sp"
            android:textColor="#374151"
            android:background="@drawable/dashboard_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:id="@+id/tvUserSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Entries: 0&#10;Last Mood: No mood recorded yet"
            android:textSize="16sp"
            android:textColor="#2C3E50"
            android:background="@drawable/dashboard_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tvTodayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today's Status&#10;You have not added a mood today yet."
            android:textSize="15sp"
            android:textColor="#374151"
            android:background="@drawable/dashboard_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tvMoodStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mood Stats&#10;Total Entries: 0&#10;Most Common Mood: No data yet&#10;Current Streak: 0 days"
            android:textSize="15sp"
            android:textColor="#374151"
            android:background="@drawable/dashboard_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnAddMood"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Add Today's Mood"
            android:textSize="17sp"
            android:backgroundTint="#4F46E5"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="View Mood History"
            android:textSize="17sp"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnCalendar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Mood Calendar"
            android:textSize="16sp"
            android:backgroundTint="#8B5CF6"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="View Profile"
            android:textSize="16sp"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnDarkMode"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Switch to Dark Mode"
            android:textSize="16sp"
            android:backgroundTint="#111827"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Logout"
            android:textSize="16sp"
            android:backgroundTint="#EF4444"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>